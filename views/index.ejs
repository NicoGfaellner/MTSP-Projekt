        <div class="col-lg-4 text-lg-end">
          <a class="btn discover-button me-2 mb-2 mb-sm-0" href="/movies">Filme ansehen</a>
          <a class="btn discover-button-outline" href="/tvshows">Serien ansehen</a>
        </div>
      </div>
    </section>

    <p class="storage-note text-center mt-4 mb-0">Die Titel oben sind Beispiele. Suche und Watchlist sind noch nicht fertig.</p>
  </div>
