        </div>
      </div>

      <div class="row g-3">
        <div class="col-6 col-md-4 col-lg">
          <article class="movie-card">
            <div class="movie-poster poster-dune"><span class="poster-kicker">EINE NEUE REISE</span><strong>DUNE</strong><small>PART TWO</small></div>
            <div class="movie-info"><h3>Dune: Part Two</h3><span>2024 · Science-Fiction</span><div class="service-tag"><span class="provider-dot prime-dot">p</span> Prime Video</div></div>
          </article>
        </div>
        <div class="col-6 col-md-4 col-lg">
          <article class="movie-card">
            <div class="movie-poster poster-shogun"><span class="poster-kicker">EIN REICH IM WANDEL</span><strong>SHŌGUN</strong><small>DISNEY+</small></div>
            <div class="movie-info"><h3>Shōgun</h3><span>2024 · Drama</span><div class="service-tag"><span class="provider-dot disney-dot">D+</span> Disney+</div></div>
          </article>
        </div>
        <div class="col-6 col-md-4 col-lg">
          <article class="movie-card">
            <div class="movie-poster poster-wednesday"><span class="poster-kicker">EIN BISSCHEN ANDERS</span><strong>WEDNESDAY</strong><small>NETFLIX</small></div>
            <div class="movie-info"><h3>Wednesday</h3><span>2022 · Mystery</span><div class="service-tag"><span class="provider-dot netflix-dot">N</span> Netflix</div></div>
          </article>
        </div>
        <div class="col-6 col-md-4 col-lg">
          <article class="movie-card">
            <div class="movie-poster poster-bear"><span class="poster-kicker">KÜCHE MIT HERZ</span><strong>THE<br>BEAR</strong><small>FX SERIES</small></div>
            <div class="movie-info"><h3>The Bear</h3><span>2022 · Comedy-Drama</span><div class="service-tag"><span class="provider-dot disney-dot">D+</span> Disney+</div></div>
          </article>
        </div>
        <div class="col-6 col-md-4 col-lg">
          <article class="movie-card">
            <div class="movie-poster poster-fallout"><span class="poster-kicker">DIE WELT DANACH</span><strong>FALLOUT</strong><small>AMAZON ORIGINAL</small></div>
            <div class="movie-info"><h3>Fallout</h3><span>2024 · Abenteuer</span><div class="service-tag"><span class="provider-dot prime-dot">p</span> Prime Video</div></div>
          </article>
        </div>
      </div>
    </section>

    <section class="discover-panel mt-5 p-4 p-md-5">
      <div class="row align-items-center g-4">
        <div class="col-lg-8">
          <h2 class="section-title mt-2">Mehr zum Projekt</h2>
