<div class="watchdeck-home container">
  <section class="home-intro">
    <h1>Filme und Serien finden</h1>
    <p class="home-lead mt-3">Mit WatchDeck wollen wir Filme und Serien sammeln und zeigen, bei welchen Streaming-Anbietern sie laufen.</p>

    <form class="home-search mt-4" action="/movies" method="get" role="search">
      <label class="visually-hidden" for="homeSearch">Filme oder Serien suchen</label>
      <input id="homeSearch" class="form-control" type="search" name="q" placeholder="Film oder Serie suchen...">
      <button class="btn home-search-button" type="submit">Suchen</button>
    </form>

    <ul class="d-flex flex-wrap gap-3 list-unstyled mt-3 mb-0" aria-label="Beispiele für Streaming-Anbieter">
      <li class="provider-label"><span class="provider-dot netflix-dot" aria-hidden="true">&Netflix;</span> Netflix</li>
      <li class="provider-label"><span class="provider-dot disney-dot" aria-hidden="true">D+</span> Disney+</li>
      <li class="provider-label"><span class="provider-dot prime-dot" aria-hidden="true">p</span> Prime Video</li>
      <li class="provider-label"><span class="provider-dot apple-dot" aria-hidden="true">tv+</span> Apple TV+</li>
    </ul>
  </section>

  <section class="examples-section mt-5" aria-labelledby="examplesHeading">
    <h2 class="section-title mb-3" id="examplesHeading">Ein paar Beispiele</h2>

    <div class="row g-3">
      <div class="col-6 col-md-4 col-lg">
        <article class="movie-card">
          <div class="movie-poster poster-dune" aria-hidden="true"><strong>Dune: Part Two</strong></div>
          <div class="movie-info"><h3>Dune: Part Two</h3><span>2024 · Science-Fiction</span><div class="service-tag"><span class="provider-dot prime-dot" aria-hidden="true">p</span> Prime Video</div></div>
        </article>
      </div>
      <div class="col-6 col-md-4 col-lg">
        <article class="movie-card">
          <div class="movie-poster poster-shogun" aria-hidden="true"><strong>Shōgun</strong></div>
          <div class="movie-info"><h3>Shōgun</h3><span>2024 · Drama</span><div class="service-tag"><span class="provider-dot disney-dot" aria-hidden="true">D+</span> Disney+</div></div>
        </article>
      </div>
      <div class="col-6 col-md-4 col-lg">
        <article class="movie-card">
          <div class="movie-poster poster-wednesday" aria-hidden="true"><strong>Wednesday</strong></div>
          <div class="movie-info"><h3>Wednesday</h3><span>2022 · Mystery</span><div class="service-tag"><span class="provider-dot netflix-dot" aria-hidden="true">N</span> Netflix</div></div>
        </article>
      </div>
      <div class="col-6 col-md-4 col-lg">
        <article class="movie-card">
          <div class="movie-poster poster-bear" aria-hidden="true"><strong>The Bear</strong></div>
          <div class="movie-info"><h3>The Bear</h3><span>2022 · Comedy-Drama</span><div class="service-tag"><span class="provider-dot disney-dot" aria-hidden="true">D+</span> Disney+</div></div>
        </article>
      </div>
      <div class="col-6 col-md-4 col-lg">
        <article class="movie-card">
          <div class="movie-poster poster-fallout" aria-hidden="true"><strong>Fallout</strong></div>
          <div class="movie-info"><h3>Fallout</h3><span>2024 · Abenteuer</span><div class="service-tag"><span class="provider-dot prime-dot" aria-hidden="true">p</span> Prime Video</div></div>
        </article>
      </div>
    </div>
    <p class="storage-note mt-2">Das sind Beispieldaten. Suche, Anbieter-Abgleich und Watchlist sind noch in Arbeit.</p>
  </section>

  <nav class="home-links mt-4 pt-4" aria-label="Film- und Serienübersicht">
    <a class="btn feature-button me-2" href="/movies">Zu den Filmen</a>
    <a class="btn discover-button-outline" href="/tvshows">Zu den Serien</a>
  </nav>
</div>
