<button type="button"
        class="btn btn-sm watchlist-button position-relative z-2"
        data-watchlist-add
        data-id="<%= item.id %>"
        data-type="<%= type %>"
        data-title="<%= title %>"
        data-year="<%= year || '' %>"
        data-poster-path="<%= item.poster_path || '' %>"
        aria-pressed="false">
  Zur Watchlist hinzufügen
</button>
